{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "documind",
    "Audience": "documind-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Storage": {
    "Container": "documind-files/"
  },
  "Chunking": {
    "TargetTokens": 600,
    "OverlapTokens": 80
  }
}
